  "name": "Lobby Manager",
  "description": "Custom lobby spawn on join, Overworld respawn on death, separate inventories, and lobby protection.",
  "authors": ["BakedGarfield"],
  "license": "MIT",
  "environment": "server",
  "entrypoints": { "main": ["io.github.bakedgarfield.lobbymanager.LobbyManager"] },
  "mixins": ["lobbymanager.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": { "mc-worlds": "*" }
}
